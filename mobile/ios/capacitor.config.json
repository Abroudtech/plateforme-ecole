{
  "appId": "fr.abroudtech.ecole",
  "appName": "Ma Plume",
  "webDir": "www",
  "server": {
    "url": "https://plumedorapp.com",
    "errorPath": "hors-ligne.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#14213d",
    "appendUserAgent": "PlateformeEcoleApp/ios",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
