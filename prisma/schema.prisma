// =============================================================================
// Modèle de données de la plateforme scolaire
// =============================================================================
//
// Principe "multi-établissement" : presque chaque table porte un champ
// `schoolId`. Toutes les lectures et écritures passent par ce champ, ce qui
// permet d'héberger plusieurs écoles dans la même base sans qu'elles voient
// les données des autres.
//
// Bilingue : les libellés visibles (noms d'élèves, de classes, de matières...)
// existent en français et en arabe (champs suffixés `Ar`).
//
// Voir docs/ARCHITECTURE.md pour une explication en français simple.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Énumérations
// -----------------------------------------------------------------------------

/// Les trois cycles de l'enseignement tunisien.
enum Cycle {
  PRIMARY // Primaire (année préparatoire + 1re à 6e année)
  MIDDLE // Collège (7e à 9e année de base)
  SECONDARY // Lycée (1re à 4e année secondaire)
}

/// Rôle d'une personne dans un établissement.
/// V1 : ADMIN et PARENT. V2 : TEACHER. V3 : STUDENT.
enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum Locale {
  fr
  ar
}

enum Gender {
  MALE
  FEMALE
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

// -----------------------------------------------------------------------------
// Établissements, comptes et rôles
// -----------------------------------------------------------------------------

/// Un établissement (une école cliente de la plateforme).
model School {
  id                  String    @id @default(cuid())
  slug                String    @unique
  nameFr              String
  nameAr              String
  city                String?
  address             String?
  phone               String?
  email               String?
  /// Cycles proposés par l'école (une école peut avoir primaire + collège + lycée).
  cycles              Cycle[]
  defaultLocale       Locale    @default(fr)
  currency            String    @default("TND")
  /// Alertes automatiques aux parents (SMS) : absence, bulletin publié, nouveau message.
  alertAbsence        Boolean   @default(true)
  alertReportCard     Boolean   @default(true)
  alertMessage        Boolean   @default(true)
  /// Les parents voient les notes au fil du trimestre (sinon seulement le bulletin publié).
  showGradesToParents Boolean   @default(false)
  /// Les parents peuvent écrire aux enseignants de leurs enfants (et inversement), sous le regard de la direction.
  teacherMessaging    Boolean   @default(true)
  /// Pas de SMS pour un parent qui reçoit déjà les notifications de l'application (économie).
  smsOnlyWithoutApp   Boolean   @default(false)
  /// Abonnement à la plateforme (géré par l'équipe de la plateforme).
  plan                String?
  /// Prix mensuel convenu, en millimes.
  planPriceMillimes   Int?
  /// Abonnement payé jusqu'au (inclus).
  paidUntil           DateTime? @db.Date
  /// Note interne de l'équipe plateforme (contact, conditions...).
  platformNote        String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships        Membership[]
  academicYears      AcademicYear[]
  terms              Term[]
  gradeLevels        GradeLevel[]
  tracks             Track[]
  classGroups        ClassGroup[]
  subjects           Subject[]
  curriculumSubjects CurriculumSubject[]
  students           Student[]
  guardians          Guardian[]
  enrollments        Enrollment[]
  assessments        Assessment[]
  evaluationSchemes  EvaluationScheme[]
  teachers           Teacher[]
  rooms              Room[]
  timetable          TimetableEntry[]
  fees               Fee[]
  studentFees        StudentFee[]
  payments           Payment[]
  paymentReminders   PaymentReminder[]
  conversations      Conversation[]
  announcements      Announcement[]
  notifications      Notification[]
  annualRules        AnnualRule[]
  teachingResources  TeachingResource[]
  challenges         Challenge[]
  site               SchoolSite?
  sitePhotos         SitePhoto[]
  siteInquiries      SiteInquiry[]
  classPosts         ClassPost[]
  aiRequests         AiRequest[]
  absenceNotes       AbsenceNote[]
  homework           Homework[]
}

/// Un compte de connexion. Une même personne peut avoir des rôles dans
/// plusieurs écoles (par ex. un parent dont les enfants sont dans deux écoles).
model User {
  id              String    @id @default(cuid())
  /// Connexion par e-mail ou par téléphone (les parents utilisent souvent le téléphone).
  email           String?   @unique
  phone           String?   @unique
  /// Identifiant des élèves (V3), qui n'ont ni téléphone ni e-mail, par ex. « yasmine.2026001 ».
  username        String?   @unique
  passwordHash    String
  firstName       String
  lastName        String
  firstNameAr     String?
  lastNameAr      String?
  preferredLocale Locale    @default(fr)
  /// Équipe de la plateforme (gestion de toutes les écoles). Jamais donné à un client.
  isPlatformAdmin Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships       Membership[]
  sessions          Session[]
  guardians         Guardian[]
  paymentsRecorded  Payment[]
  remindersSent     PaymentReminder[]
  /// Compte élève (V3), relié à la fiche élève.
  student           Student?
  messages          Message[]
  conversationReads ConversationRead[]
  announcements     Announcement[]
  /// Fiche enseignant reliée à ce compte (V2), une par école.
  teachers          Teacher[]
  teachingResources TeachingResource[]
  classPosts        ClassPost[]
  postReactions     PostReaction[]
  challenges        Challenge[]
  passwordResets    PasswordReset[]
  pushSubscriptions PushSubscription[]
  homework          Homework[]
}

/// Le rôle d'un compte dans une école donnée.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
}

/// Session de connexion. Le navigateur garde un jeton secret ; la base ne
/// garde que son empreinte (hash), jamais le jeton lui-même.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  /// École choisie quand le compte a accès à plusieurs écoles.
  activeSchoolId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  userAgent      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Organisation scolaire : années, périodes, niveaux, filières, classes
// -----------------------------------------------------------------------------

/// Année scolaire, par ex. "2026-2027".
model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms       Term[]
  classGroups ClassGroup[]
  enrollments Enrollment[]
  fees        Fee[]
  payments    Payment[]

  @@unique([schoolId, label])
}

/// Période d'évaluation (trimestre ou semestre). `cycle` vide = valable pour
/// tous les cycles ; sinon la période ne concerne qu'un cycle, ce qui permet
/// d'avoir des trimestres au primaire et un autre découpage au lycée.
model Term {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  cycle          Cycle?
  order          Int
  nameFr         String
  nameAr         String
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date

  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assessments  Assessment[]
  comments     TermComment[]
  publications ReportCardPublication[]

  @@index([schoolId, academicYearId])
}

/// Niveau scolaire : "1re année", "7e année de base", "4e année secondaire"...
model GradeLevel {
  id       String @id @default(cuid())
  schoolId String
  cycle    Cycle
  /// Code stable, par ex. "P1", "C7", "S4".
  code     String
  /// Rang global de 0 (préparatoire) à 13 (4e secondaire), pour trier.
  rank     Int
  nameFr   String
  nameAr   String

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroups        ClassGroup[]
  curriculumSubjects CurriculumSubject[]
  evaluationSchemes  EvaluationScheme[]
  fees               Fee[]
  announcements      Announcement[]
  teachingResources  TeachingResource[]

  @@unique([schoolId, code])
  @@index([schoolId, cycle])
}

/// Filière / section du lycée : Mathématiques, Sciences expérimentales, Lettres...
model Track {
  id       String @id @default(cuid())
  schoolId String
  code     String
  nameFr   String
  nameAr   String

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroups        ClassGroup[]
  curriculumSubjects CurriculumSubject[]
  evaluationSchemes  EvaluationScheme[]

  @@unique([schoolId, code])
}

/// Une classe pour une année donnée, par ex. "7B1" en 2026-2027.
model ClassGroup {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  gradeLevelId   String
  trackId        String?
  name           String
  nameAr         String?
  capacity       Int?
  createdAt      DateTime @default(now())

  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel         GradeLevel              @relation(fields: [gradeLevelId], references: [id])
  track              Track?                  @relation(fields: [trackId], references: [id])
  enrollments        Enrollment[]
  assessments        Assessment[]
  publications       ReportCardPublication[]
  attendance         AttendanceRecord[]
  rollCalls          RollCall[]
  evaluationSchemes  EvaluationScheme[]
  timetable          TimetableEntry[]
  announcements      Announcement[]
  teacherAssignments TeacherAssignment[]
  posts              ClassPost[]
  challenges         Challenge[]
  gameScores         GameScore[]
  homework           Homework[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
}

/// Matière enseignée (catalogue de l'école).
model Subject {
  id       String @id @default(cuid())
  schoolId String
  code     String
  nameFr   String
  nameAr   String

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  curriculumSubjects CurriculumSubject[]
  assessments        Assessment[]
  evaluationSchemes  EvaluationScheme[]
  timetable          TimetableEntry[]
  teachingResources  TeachingResource[]
  challenges         Challenge[]
  homework           Homework[]

  @@unique([schoolId, code])
}

/// Programme : quelle matière est enseignée à quel niveau (et filière au
/// lycée), avec quel coefficient. Servira au calcul des moyennes et bulletins.
model CurriculumSubject {
  id           String   @id @default(cuid())
  schoolId     String
  gradeLevelId String
  trackId      String?
  subjectId    String
  coefficient  Decimal  @default(1) @db.Decimal(4, 2)
  hoursPerWeek Decimal? @db.Decimal(4, 1)

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  track      Track?     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeLevelId, trackId, subjectId])
  @@index([schoolId])
}

// -----------------------------------------------------------------------------
// Élèves et familles
// -----------------------------------------------------------------------------

/// Fiche élève. Le compte de connexion élève (`userId`) viendra en V3.
model Student {
  id            String    @id @default(cuid())
  schoolId      String
  /// Matricule interne de l'école.
  studentNumber String
  firstName     String
  lastName      String
  firstNameAr   String?
  lastNameAr    String?
  gender        Gender?
  birthDate     DateTime? @db.Date
  birthPlace    String?
  isActive      Boolean   @default(true)
  userId        String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  guardians         StudentGuardian[]
  grades            Grade[]
  termComments      TermComment[]
  attendance        AttendanceRecord[]
  studentFees       StudentFee[]
  payments          Payment[]
  reminders         PaymentReminder[]
  conversations     Conversation[]
  challengeAttempts ChallengeAttempt[]
  gameScores        GameScore[]
  absenceNotes      AbsenceNote[]

  @@unique([schoolId, studentNumber])
  @@index([schoolId, lastName])
}

/// Parent ou tuteur. Existe même sans compte sur l'application (on peut
/// quand même lui envoyer des SMS de relance). `userId` relie au compte parent.
model Guardian {
  id          String   @id @default(cuid())
  schoolId    String
  firstName   String
  lastName    String
  firstNameAr String?
  lastNameAr  String?
  phone       String?
  email       String?
  /// Numéro WhatsApp s'il est différent du téléphone.
  whatsapp    String?
  userId      String?
  createdAt   DateTime @default(now())

  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students      StudentGuardian[]
  conversations Conversation[]
  notifications Notification[]

  @@unique([schoolId, userId])
  @@index([schoolId])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship GuardianRelationship
  /// Contact principal pour l'école (messages, relances de paiement).
  isPrimary    Boolean              @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

/// Inscription d'un élève dans une classe pour une année scolaire.
model Enrollment {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  classGroupId   String
  status         EnrollmentStatus @default(ACTIVE)
  /// Passage à l'année suivante : « LEAVE » = l'élève quitte l'école à la fin de cette année.
  nextStep       String?
  enrolledAt     DateTime         @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, classGroupId])
}

// -----------------------------------------------------------------------------
// Notes et bulletins (étape 3)
// -----------------------------------------------------------------------------

/// Type d'évaluation (usage tunisien).
enum AssessmentKind {
  CONTROL // Devoir de contrôle
  SYNTHESIS // Devoir de synthèse
  ORAL // Oral
  PRACTICAL // Travaux pratiques
  OTHER // Autre (test, projet...)
}

/// Une évaluation passée par une classe dans une matière, pendant un trimestre.
model Assessment {
  id           String         @id @default(cuid())
  schoolId     String
  classGroupId String
  subjectId    String
  termId       String
  kind         AssessmentKind
  title        String?
  date         DateTime?      @db.Date
  /// Barème (20 par défaut).
  maxScore     Decimal        @default(20) @db.Decimal(5, 2)
  /// Poids de cette évaluation dans la moyenne de la matière.
  weight       Decimal        @default(1) @db.Decimal(4, 2)
  createdAt    DateTime       @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term       Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  grades     Grade[]

  @@index([schoolId, classGroupId, termId])
}

/// La note d'un élève à une évaluation. `score` vide + `absent` = absent.
model Grade {
  id           String   @id @default(cuid())
  schoolId     String
  assessmentId String
  studentId    String
  score        Decimal? @db.Decimal(5, 2)
  absent       Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId])
}

/// Appréciation générale du conseil de classe pour un élève et un trimestre.
model TermComment {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  termId    String
  comment   String
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
}

/// Calcul de la moyenne annuelle d'un cycle : poids de chaque trimestre
/// (par ex. 1, 2, 2) et moyenne d'admission. Modifiable par l'école.
model AnnualRule {
  id          String  @id @default(cuid())
  schoolId    String
  cycle       Cycle
  termWeights Float[]
  passMark    Float   @default(10)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, cycle])
}

/// Publication des bulletins d'une classe pour un trimestre : tant qu'ils ne
/// sont pas publiés, les parents ne les voient pas.
model ReportCardPublication {
  id           String   @id @default(cuid())
  schoolId     String
  classGroupId String
  termId       String
  publishedAt  DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  term       Term       @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, termId])
}

// -----------------------------------------------------------------------------
// Absences (étape 4)
// -----------------------------------------------------------------------------

/// Demi-journée concernée par l'appel.
enum DayPeriod {
  MORNING // Matin
  AFTERNOON // Après-midi
}

enum AttendanceStatus {
  ABSENT
  LATE // Retard
}

/// Une absence ou un retard d'un élève. Un élève présent n'a pas de ligne.
model AttendanceRecord {
  id           String           @id @default(cuid())
  schoolId     String
  studentId    String
  classGroupId String
  date         DateTime         @db.Date
  period       DayPeriod
  status       AttendanceStatus
  justified    Boolean          @default(false)
  reason       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, period])
  @@index([schoolId, date])
  @@index([classGroupId, date])
}

/// Trace qu'un appel a été fait pour une classe (même si tout le monde était présent).
model RollCall {
  id           String    @id @default(cuid())
  schoolId     String
  classGroupId String
  date         DateTime  @db.Date
  period       DayPeriod
  createdAt    DateTime  @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, date, period])
  @@index([schoolId, date])
}

// -----------------------------------------------------------------------------
// Structure des notes (étape 5)
// -----------------------------------------------------------------------------

/// Structure d'évaluation : quelles notes existent (oral, contrôle, synthèse...)
/// et combien chacune compte. Elle peut être définie à plusieurs endroits ;
/// la plus précise l'emporte :
///   1. classe + matière      4. niveau/filière (toutes matières)
///   2. classe (toutes)       5. école (toutes matières)
///   3. niveau/filière + matière
/// Sans rien de défini : oral ×1, contrôle ×1, synthèse ×2.
model EvaluationScheme {
  id           String  @id @default(cuid())
  schoolId     String
  gradeLevelId String?
  trackId      String?
  classGroupId String?
  subjectId    String?

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel?            @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  track      Track?                 @relation(fields: [trackId], references: [id], onDelete: Cascade)
  classGroup ClassGroup?            @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject?               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  items      EvaluationSchemeItem[]

  @@index([schoolId])
}

model EvaluationSchemeItem {
  id       String         @id @default(cuid())
  schemeId String
  kind     AssessmentKind
  weight   Decimal        @db.Decimal(4, 2)

  scheme EvaluationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, kind])
}

// -----------------------------------------------------------------------------
// Emplois du temps (étape 6)
// -----------------------------------------------------------------------------

/// Enseignant de l'école. `userId` servira au compte enseignant (V2).
model Teacher {
  id          String   @id @default(cuid())
  schoolId    String
  firstName   String
  lastName    String
  firstNameAr String?
  lastNameAr  String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())

  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries       TimetableEntry[]
  assignments   TeacherAssignment[]
  conversations Conversation[]

  @@unique([schoolId, userId])
  @@index([schoolId])
}

/// Classes confiées à un enseignant (en plus de celles de son emploi du temps).
/// Un enseignant fait l'appel et saisit les notes de ses classes uniquement.
model TeacherAssignment {
  id           String @id @default(cuid())
  schoolId     String
  teacherId    String
  classGroupId String

  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classGroupId])
  @@index([schoolId, classGroupId])
}

enum ResourceKind {
  LESSON
  EXERCISES
  EXAM
}

/// Document pédagogique préparé avec l'atelier (IA) : fiche de cours,
/// série d'exercices ou examen. Contenu en Markdown, modifiable.
model TeachingResource {
  id           String       @id @default(cuid())
  schoolId     String
  authorId     String
  kind         ResourceKind
  gradeLevelId String
  subjectId    String
  title        String
  topic        String
  /// Langue du document : "ar", "fr" ou "en" selon la matière.
  language     String
  content      String
  /// Demande d'origine (consignes de l'enseignant), pour pouvoir la refaire.
  request      Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  homework   Homework[]

  @@index([schoolId, authorId, createdAt])
}

/// Cahier de textes : ce qui a été fait en classe et le travail à faire.
/// Visible par les parents et les élèves de la classe.
model Homework {
  id           String    @id @default(cuid())
  schoolId     String
  classGroupId String
  subjectId    String?
  authorId     String?
  /// Jour de la séance.
  date         DateTime  @db.Date
  /// Ce qui a été fait pendant la séance.
  lesson       String?   @db.Text
  /// Travail à faire (devoirs).
  task         String?   @db.Text
  /// Pour quand (facultatif).
  dueDate      DateTime? @db.Date
  /// Document de l'atelier joint (fiche, exercices), consultable en lecture.
  resourceId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup        @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  resource   TeachingResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([classGroupId, date])
  @@index([schoolId, dueDate])
}

/// Salle de classe, laboratoire, terrain de sport...
model Room {
  id       String @id @default(cuid())
  schoolId String
  name     String
  capacity Int?

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([schoolId, name])
}

/// Un cours dans l'emploi du temps hebdomadaire d'une classe.
/// Jour : 1 = lundi ... 6 = samedi. Heures en minutes depuis minuit (8h30 = 510).
model TimetableEntry {
  id           String  @id @default(cuid())
  schoolId     String
  classGroupId String
  subjectId    String
  teacherId    String?
  roomId       String?
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room       Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([schoolId, dayOfWeek])
  @@index([classGroupId])
  @@index([teacherId])
}

// -----------------------------------------------------------------------------
// Paiements des familles (étape 7)
// Les montants sont stockés en millimes (1 DT = 1000 millimes) pour éviter
// les erreurs d'arrondi.
// -----------------------------------------------------------------------------

/// Un frais de l'année : inscription, scolarité du 1er trimestre, cantine…
/// Obligatoire : dû par tous les élèves du niveau (ou de toute l'école).
/// Optionnel (cantine, transport…) : dû seulement par les élèves inscrits à ce service.
model Fee {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  /// null = tous les niveaux
  gradeLevelId   String?
  name           String
  nameAr         String?
  amountMillimes Int
  dueDate        DateTime @db.Date
  isOptional     Boolean  @default(false)
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel?  @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  students     StudentFee[]

  @@index([schoolId, academicYearId])
}

/// Lien élève ↔ frais : inscription à un service optionnel, ou montant
/// personnalisé (réduction fratrie, bourse, exonération = 0).
model StudentFee {
  id             String  @id @default(cuid())
  schoolId       String
  studentId      String
  feeId          String
  /// null = montant normal du frais
  amountMillimes Int?
  note           String?
  /// Pour les listes de service : arrêt du bus, allergie à la cantine, groupe d'activité...
  serviceInfo    String?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fee     Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeId])
  @@index([schoolId])
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CARD
  OTHER
}

/// Un encaissement. Il n'est jamais supprimé : on l'annule (le numéro de reçu
/// reste réservé, pour la comptabilité).
model Payment {
  id             String        @id @default(cuid())
  schoolId       String
  studentId      String
  /// Année scolaire à laquelle le paiement est imputé.
  academicYearId String
  receiptNumber  Int
  amountMillimes Int
  method         PaymentMethod
  reference      String?
  note           String?
  paidAt         DateTime      @db.Date
  createdById    String?
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelReason   String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, studentId])
  @@index([schoolId, paidAt])
}

enum ReminderChannel {
  LETTER
  WHATSAPP
  SMS
  CALL
}

/// Trace des relances d'impayés envoyées aux familles.
model PaymentReminder {
  id             String          @id @default(cuid())
  schoolId       String
  studentId      String
  channel        ReminderChannel
  amountMillimes Int
  createdById    String?
  createdAt      DateTime        @default(now())

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId])
}

// -----------------------------------------------------------------------------
// Messagerie (étape 8)
// -----------------------------------------------------------------------------

/// Conversation entre l'école et un parent (au sujet d'un enfant, en général).
model Conversation {
  id            String   @id @default(cuid())
  schoolId      String
  guardianId    String
  studentId     String?
  /// Enseignant concerné (null = conversation avec la direction). La direction voit toutes les conversations.
  teacherId     String?
  subject       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian           @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher  Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  messages Message[]
  reads    ConversationRead[]

  @@index([schoolId, lastMessageAt])
  @@index([guardianId])
  @@index([teacherId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  /// Vrai si le message vient de l'école (administration, plus tard enseignants).
  fromSchool     Boolean
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

/// Jusqu'où chaque personne a lu une conversation (pour les « non lus »).
model ConversationRead {
  conversationId String
  userId         String
  lastReadAt     DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

enum AnnouncementAudience {
  SCHOOL
  LEVEL
  CLASS
}

/// Annonce de l'école aux familles : toute l'école, un niveau ou une classe.
model Announcement {
  id           String               @id @default(cuid())
  schoolId     String
  title        String
  body         String               @db.Text
  audience     AnnouncementAudience
  gradeLevelId String?
  classGroupId String?
  /// Prévenir aussi les parents par SMS.
  sendAlert    Boolean              @default(false)
  createdById  String?
  createdAt    DateTime             @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

enum NotificationKind {
  ABSENCE
  REPORT_CARD
  ANNOUNCEMENT
  MESSAGE
  PAYMENT
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  /// Aucun fournisseur SMS configuré : le message est seulement enregistré.
  SIMULATED
  FAILED
}

/// File d'envoi des alertes (SMS aujourd'hui, WhatsApp plus tard).
model Notification {
  id         String              @id @default(cuid())
  schoolId   String
  guardianId String?
  kind       NotificationKind
  channel    NotificationChannel @default(SMS)
  toPhone    String
  body       String              @db.Text
  status     NotificationStatus  @default(PENDING)
  error      String?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([status])
}

/// Tentatives de connexion, pour bloquer quelques minutes après trop d'échecs.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// -----------------------------------------------------------------------------
// Espace de classe et espace élève (V3)
// -----------------------------------------------------------------------------

enum PostStatus {
  /// Proposé par un élève, en attente de l'enseignant.
  PENDING
  PUBLISHED
  REJECTED
}

/// Mur de la classe. L'enseignant publie directement ; les messages des élèves
/// n'apparaissent qu'après validation. Pas de messagerie entre élèves.
model ClassPost {
  id           String     @id @default(cuid())
  schoolId     String
  classGroupId String
  authorId     String
  body         String
  status       PostStatus @default(PUBLISHED)
  isPinned     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  reviewedAt   DateTime?

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  PostReaction[]

  @@index([classGroupId, status, createdAt])
}

/// Réaction (émoji choisi dans une courte liste) : une par personne et par message.
model PostReaction {
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post ClassPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// Défi (quiz à choix multiples) proposé par l'enseignant à une classe.
model Challenge {
  id           String    @id @default(cuid())
  schoolId     String
  classGroupId String
  authorId     String
  subjectId    String?
  title        String
  /// Questions : [{ q, choices: string[], answer: index }]
  questions    Json
  closesAt     DateTime?
  createdAt    DateTime  @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject    Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  attempts   ChallengeAttempt[]

  @@index([classGroupId, createdAt])
}

/// Réponse d'un élève à un défi (une seule tentative).
model ChallengeAttempt {
  id          String   @id @default(cuid())
  schoolId    String
  challengeId String
  studentId   String
  answers     Json
  score       Int
  maxScore    Int
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([challengeId, studentId])
}

/// Partie d'un jeu éducatif (calcul, tables, lettres, mots).
model GameScore {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  classGroupId String
  game         String
  score        Int
  createdAt    DateTime @default(now())

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@index([classGroupId, createdAt])
  @@index([studentId, game, createdAt])
}

/// Utilisation de l'IA hors atelier (par ex. questions proposées pour un défi),
/// comptée dans la limite mensuelle de l'école.
model AiRequest {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  kind      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

/// Mot de passe oublié : code reçu par SMS (SMS_CODE), ou demande traitée
/// par la direction de l'école (SCHOOL).
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  kind        String
  /// Empreinte du code à 6 chiffres (jamais le code lui-même).
  codeHash    String?
  attempts    Int       @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  handledById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, usedAt])
}

/// Notifications sur le téléphone (application installée sur l'écran d'accueil).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Réglages techniques de la plateforme (par ex. clés des notifications), créés automatiquement.
model PlatformSetting {
  key   String @id
  value String
}

/// Justificatif d'absence envoyé par un parent (motif + photo éventuelle),
/// validé ou refusé par la direction.
model AbsenceNote {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  authorId     String
  /// Absences concernées (identifiants des AttendanceRecord).
  recordIds    String[]
  reason       String
  fileData     Bytes?
  fileType     String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Page vitrine publique de l'école (site internet), réglée par la direction
// ---------------------------------------------------------------------------

/// Contenu de la page vitrine d'une école. Chaque texte existe en français et
/// en arabe ; si l'une des deux langues est vide, l'autre est affichée.
model SchoolSite {
  id            String   @id @default(cuid())
  schoolId      String   @unique
  /// Visible par tous sur Internet (sinon seule la direction voit l'aperçu).
  published     Boolean  @default(false)
  /// Adresse propre de l'école (ex. « laplume-dor.tn »), réglée par l'équipe plateforme.
  domain        String?  @unique
  /// Couleur de la page (voir src/lib/site/themes.ts).
  theme         String   @default("encre")
  heroTitleFr   String?
  heroTitleAr   String?
  heroTextFr    String?
  heroTextAr    String?
  aboutFr       String?
  aboutAr       String?
  /// Atouts de l'école : [{ titleFr, titleAr, textFr, textAr }].
  highlights    Json     @default("[]")
  /// Texte libre par cycle : { PRIMARY: { fr, ar }, ... }.
  cycleTexts    Json     @default("{}")
  admissionsFr  String?
  admissionsAr  String?
  hoursFr       String?
  hoursAr       String?
  whatsapp      String?
  facebookUrl   String?
  instagramUrl  String?
  mapUrl        String?
  /// Formulaire « Demande de renseignements » affiché sur la page.
  inquiryForm   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

enum SitePhotoKind {
  LOGO
  HERO
  GALLERY
}

/// Photo de la page vitrine (logo, grande photo d'accueil, galerie).
model SitePhoto {
  id        String        @id @default(cuid())
  schoolId  String
  kind      SitePhotoKind
  data      Bytes
  mimeType  String
  captionFr String?
  captionAr String?
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind, position])
}

/// Demande de renseignements ou d'inscription envoyée depuis la page vitrine.
model SiteInquiry {
  id         String    @id @default(cuid())
  schoolId   String
  parentName String
  phone      String
  email      String?
  childLevel String?
  message    String
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}
