# Adresse de la base de données PostgreSQL.
# Avec docker compose (voir README) :
DATABASE_URL="postgresql://ecole:ecole@localhost:5432/ecole"

# Mot de passe des comptes de démonstration créés par `npm run db:seed`.
SEED_PASSWORD="Demo2026!"

# Alertes SMS aux parents (facultatif). Sans ces lignes, les alertes sont
# préparées et visibles dans « Messagerie > Alertes SMS », mais pas envoyées.
# Le fournisseur reçoit un POST JSON { "to": "+216…", "from": SMS_SENDER, "text": "…" }.
# SMS_API_URL="https://passerelle-sms.exemple.tn/send"
# SMS_API_TOKEN=""
# SMS_SENDER="ECOLE"
