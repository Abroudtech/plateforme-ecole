# Nom de domaine de la plateforme (il doit pointer vers l'adresse IP du serveur).
DOMAINE=ecole.exemple.tn

# Mot de passe de la base de données : une longue suite de caractères au hasard.
DB_PASSWORD=changez-moi-par-un-long-mot-de-passe

# SMS (plus tard, quand un fournisseur sera choisi)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=

# Atelier IA des enseignants (clé créée sur console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MONTHLY_LIMIT=300
